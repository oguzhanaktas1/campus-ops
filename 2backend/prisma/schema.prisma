generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RoleScope {
  GLOBAL
  FACULTY
  DEPARTMENT
  UNIT
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  WAITING_APPROVAL
  APPROVED
  REJECTED
  REVISION_REQUESTED
  CANCELLED
  COMPLETED
  CLOSED
  EXPIRED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkflowStepType {
  START
  REVIEW
  APPROVAL
  REVISION
  ASSIGNMENT
  AUTO_ACTION
  END
}

enum WorkflowActionType {
  SUBMIT
  APPROVE
  REJECT
  REQUEST_REVISION
  ASSIGN
  ESCALATE
  CANCEL
  COMPLETE
  AUTO_TRANSITION
}

enum TicketStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
  REOPENED
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  IN_APP
  EMAIL
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum FileCategory {
  DOCUMENT
  IMAGE
  PDF
  ARCHIVE
  OTHER
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  ASSIGN
  EXPORT
  UPLOAD
  DOWNLOAD
  STATUS_CHANGE
}

enum IntegrationStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum ResourceType {
  ROOM
  LAB
  EQUIPMENT
  VEHICLE
  DESK
  OTHER
}

model User {
  id                String      @id @default(cuid())
  //firebaseUid       String      @unique
  email             String      @unique
  password            String
  phoneNumber       String?
  status            UserStatus  @default(ACTIVE)
  isEmailVerified   Boolean     @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  profile           UserProfile?

  assignedFaculties Faculty[]   @relation("FacultyDean")
  chairedDepartments Department[] @relation("DepartmentChair")
  managedUnits      Unit[]      @relation("UnitManager")
  
  primaryRoles      UserRole[] @relation("UserToUserRole")
  rolesAssignedByMe UserRole[] @relation("AssignedRoles")
  requesterRequests Request[]   @relation("RequestRequester")
  assigneeRequests  Request[]   @relation("RequestAssignee")

  requestStatusChanges RequestStatusHistory[]
  requestAssignmentsAssignedTo RequestAssignment[] @relation("RequestAssignmentAssignedTo")
  requestAssignmentsAssignedBy RequestAssignment[] @relation("RequestAssignmentAssignedBy")

  requestComments   RequestComment[]
  requestWatchers   RequestWatcher[]
  calendarEvents      CalendarEvent[]

  workflowDefinitionsCreated WorkflowDefinition[]
  workflowStepsAssignedUser WorkflowStep[] @relation("WorkflowStepAssignedUser")
  workflowInstanceStepsAssignedTo WorkflowInstanceStep[] @relation("WorkflowInstanceStepAssignedTo")
  workflowInstanceStepsActionBy WorkflowInstanceStep[] @relation("WorkflowInstanceStepActionBy")
  approvalActions   ApprovalAction[]

  internshipRequestsAsStudent InternshipRequest[] @relation("InternshipStudent")
  internshipRequestsAsAdvisor InternshipRequest[] @relation("InternshipAdvisor")
  equipmentRequestsRequester  EquipmentRequest[]  @relation("EquipmentRequester")
  itTicketsReportedBy         ItTicket[]          @relation("TicketReportedBy")
  itTicketsAssignedTo         ItTicket[]          @relation("TicketAssignedTo")

  roomReservationRequesters RoomReservationRequest[] @relation("RoomReservationRequester")
  eventRequestOrganizers     EventRequest[]           @relation("EventOrganizer")
  accessRequesters           AccessRequest[]          @relation("AccessRequester")
  procurementRequesters      ProcurementRequest[]     @relation("ProcurementRequester")
  documentRequesters         DocumentRequest[]        @relation("DocumentRequester")
  appointmentRequesters      AppointmentRequest[]     @relation("AppointmentRequester")
  appointmentTargets         AppointmentRequest[]     @relation("AppointmentTarget")

  reservationsCreated    Reservation[] @relation("ReservationCreator")
  reservationsApprovedBy Reservation[] @relation("ReservationApprover")

  appointmentsRequested Appointment[] @relation("AppointmentRequester")
  appointmentsHosted    Appointment[] @relation("AppointmentHost")
  appointmentsNoShowMarked Appointment[] @relation("AppointmentNoShowMarker")
  appointmentParticipants AppointmentParticipant[]
  availabilitySlots      UserAvailabilitySlot[]

  clubsAdvising   Club[]       @relation("ClubAdvisor")
  clubsPresiding  Club[]       @relation("ClubPresident")
  clubMemberships ClubMember[]

  uploadedFiles   File[]
  notifications   Notification[]
  emailLogs       EmailLog[]
  notificationPreference NotificationPreference?

  auditLogs       AuditLog[]
  loginHistories  LoginHistory[]

  integrationsCreated Integration[] @relation("IntegrationCreatedBy")

  reportSnapshotsGenerated ReportSnapshot[]

  eventPlansOrganized        EventPlan[]                @relation("EventPlanOrganizer")
  eventCreationRequests      EventCreationRequest[]     @relation("EventCreationOrganizer")
  eventsOrganized            Event[]                    @relation("EventOrganizer2")
  eventPlanRegistrations     EventPlanRegistration[]    @relation("EventPlanRegistrant")
  eventRegistrations         EventRegistration[]        @relation("EventRegistrant")
  eventDecisionLogs          EventDecisionLog[]         @relation("EventDecisionMaker")
}

model UserProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  firstName     String
  lastName      String
  fullName      String
  avatarUrl     String?
  gender        Gender?
  birthDate     DateTime?
  studentNumber String?   @unique
  staffNumber   String?   @unique
  title         String?
  facultyId     String?
  departmentId  String?
  unitId        String?
  bio           String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  faculty       Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([facultyId])
  @@index([departmentId])
  @@index([unitId])
}

model Campus {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  faculties   Faculty[]
  units       Unit[]
  resources   Resource[]
  dailyMetrics DailyMetric[]
}

model Faculty {
  id            String      @id @default(cuid())
  campusId      String
  name          String
  code          String      @unique
  deanUserId    String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  campus        Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  dean          User?       @relation("FacultyDean", fields: [deanUserId], references: [id], onDelete: SetNull)

  departments   Department[]
  units         Unit[]
  userProfiles  UserProfile[]
  userRoles     UserRole[]
  requests      Request[]
  resources     Resource[]
  clubs         Club[]
  dailyMetrics  DailyMetric[]

  @@index([campusId])
  @@index([deanUserId])
}

model Department {
  id            String      @id @default(cuid())
  facultyId      String
  name          String
  code          String      @unique
  chairUserId   String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  faculty       Faculty     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  chair         User?       @relation("DepartmentChair", fields: [chairUserId], references: [id], onDelete: SetNull)

  units         Unit[]
  userProfiles  UserProfile[]
  userRoles     UserRole[]
  requests      Request[]
  resources     Resource[]
  dailyMetrics  DailyMetric[]

  @@index([facultyId])
  @@index([chairUserId])
}

model Unit {
  id            String      @id @default(cuid())
  campusId      String?
  facultyId     String?
  departmentId  String?
  name          String
  code          String      @unique
  type          String
  managerUserId String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  campus        Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  faculty       Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager       User?       @relation("UnitManager", fields: [managerUserId], references: [id], onDelete: SetNull)

  userProfiles  UserProfile[]
  userRoles     UserRole[]
  requests      Request[]
  workflowSteps WorkflowStep[]
  resources     Resource[]
  dailyMetrics  DailyMetric[]

  @@index([campusId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([managerUserId])
}

model AcademicTerm {
  id         String    @id @default(cuid())
  name       String
  code       String    @unique
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  internshipRequests InternshipRequest[]
}

model Role {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  scopeType    RoleScope
  isSystem     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  permissions  RolePermission[]
  userRoles    UserRole[]
  workflowSteps WorkflowStep[] @relation("WorkflowStepAssignedRole")
}

model Permission {
  id           String           @id @default(cuid())
  key          String           @unique
  name         String
  description  String?
  moduleName   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  roles        RolePermission[]
}

model RolePermission {
  id            String      @id @default(cuid())
  roleId        String
  permissionId  String
  createdAt     DateTime    @default(now())

  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id               String      @id @default(cuid())
  userId           String
  roleId           String
  facultyId        String?
  departmentId     String?
  unitId           String?
  isPrimary        Boolean     @default(false)
  assignedByUserId String?
  assignedAt       DateTime    @default(now())
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation("UserToUserRole", fields: [userId], references: [id], onDelete: Cascade)
  role             Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  faculty          Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unit             Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assignedBy       User?       @relation("AssignedRoles", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, facultyId, departmentId, unitId])
  @@index([userId])
  @@index([roleId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([unitId])
}

model RequestType {
  id                   String               @id @default(cuid())
  key                  String               @unique
  name                 String
  description          String?
  category             String
  workflowDefinitionId String?
  formSchemaJson       Json?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  workflowDefinition   WorkflowDefinition?  @relation(fields: [workflowDefinitionId], references: [id], onDelete: SetNull)
  requests             Request[]
  slaPolicies          SlaPolicy[]
  dailyMetrics         DailyMetric[]

  @@index([workflowDefinitionId])
}

model Request {
  id                    String               @id @default(cuid())
  requestTypeId         String
  requestNo             String               @unique
  title                 String
  description           String?
  status                RequestStatus        @default(DRAFT)
  priority              PriorityLevel        @default(MEDIUM)
  requesterUserId       String
  currentAssigneeUserId String?
  facultyId             String?
  departmentId          String?
  unitId                String?
  workflowInstanceId    String?              @unique
  submittedAt           DateTime?
  dueAt                 DateTime?
  closedAt              DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?
  sourceChannel         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?

  dynamicData Json?
  
  requestType           RequestType          @relation(fields: [requestTypeId], references: [id], onDelete: Restrict)
  requester             User                 @relation("RequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  currentAssignee       User?                @relation("RequestAssignee", fields: [currentAssigneeUserId], references: [id], onDelete: SetNull)
  faculty               Faculty?             @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department            Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unit                  Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)

  fileLinks             FileLink[]
  workflowInstance      WorkflowInstance?
  statusHistory         RequestStatusHistory[]
  assignments           RequestAssignment[]
  comments              RequestComment[]
  watchers              RequestWatcher[]
  tagLinks              RequestTagLink[]
  calendarEvents      CalendarEvent[]

  approvalActions       ApprovalAction[]
  
  internshipRequest       InternshipRequest?
  equipmentRequest        EquipmentRequest?
  itTicket                ItTicket?
  roomReservationRequest  RoomReservationRequest?
  eventRequest            EventRequest?
  accessRequest           AccessRequest?
  procurementRequest      ProcurementRequest?
  documentRequest         DocumentRequest?
  appointmentRequest      AppointmentRequest?
  eventCreationRequest    EventCreationRequest?

  reservations          Reservation[]
  notifications         Notification[]
  emailLogs             EmailLog[]
  webhookLogs           WebhookLog[]
  integrationJobs       IntegrationJob[]
  n8nWorkflowRuns       N8nWorkflowRun[]
  slaEvents             SlaEvent[]

  @@index([requestTypeId])
  @@index([requesterUserId])
  @@index([currentAssigneeUserId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([facultyId])
  @@index([departmentId])
  @@index([unitId])
  @@index([requestTypeId, createdAt])
}

model RequestStatusHistory {
  id               String         @id @default(cuid())
  requestId        String
  oldStatus        RequestStatus?
  newStatus        RequestStatus
  changedByUserId  String?
  changeReason     String?
  changedAt        DateTime       @default(now())
  metadataJson     Json?

  request          Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy        User?          @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([requestId, changedAt])
  @@index([changedByUserId])
}

model RequestAssignment {
  id               String      @id @default(cuid())
  requestId        String
  assignedToUserId String
  assignedByUserId String?
  assignmentNote   String?
  assignedAt       DateTime    @default(now())
  unassignedAt     DateTime?
  isActive         Boolean     @default(true)

  request          Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignedTo       User        @relation("RequestAssignmentAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  assignedBy       User?       @relation("RequestAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([assignedToUserId])
  @@index([assignedByUserId])
  @@index([isActive])
}

model RequestComment {
  id               String           @id @default(cuid())
  requestId        String
  userId           String
  commentText      String
  isInternal       Boolean          @default(false)
  parentCommentId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  request          Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentComment    RequestComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies          RequestComment[] @relation("CommentReplies")

  @@index([requestId, createdAt])
  @@index([userId])
  @@index([parentCommentId])
}

model RequestWatcher {
  id         String    @id @default(cuid())
  requestId  String
  userId     String
  createdAt  DateTime  @default(now())

  request    Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
}

model RequestTag {
  id         String          @id @default(cuid())
  name       String          @unique
  color      String?
  createdAt  DateTime        @default(now())

  requestLinks RequestTagLink[]
}

model RequestTagLink {
  id         String      @id @default(cuid())
  requestId  String
  tagId      String

  request    Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tag        RequestTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([requestId, tagId])
  @@index([tagId])
}

model WorkflowDefinition {
  id              String              @id @default(cuid())
  key             String              @unique
  name            String
  description     String?
  version         Int
  isActive        Boolean             @default(true)
  isDefault       Boolean             @default(false)
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  createdBy       User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  requestTypes    RequestType[]
  steps           WorkflowStep[]
  transitions     WorkflowTransition[]
  instances       WorkflowInstance[]

  @@index([createdByUserId])
}

model WorkflowStep {
  id                   String              @id @default(cuid())
  workflowDefinitionId String
  stepKey              String
  stepName             String
  stepOrder            Int
  stepType             WorkflowStepType
  assignedRoleId       String?
  assignedUnitId       String?
  assignedUserId       String?
  isRequired           Boolean             @default(true)
  allowSkip            Boolean             @default(false)
  slaHours             Int?
  configJson           Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workflowDefinition   WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  assignedRole         Role?               @relation("WorkflowStepAssignedRole", fields: [assignedRoleId], references: [id], onDelete: SetNull)
  assignedUnit         Unit?               @relation(fields: [assignedUnitId], references: [id], onDelete: SetNull)
  assignedUser         User?               @relation("WorkflowStepAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  fromTransitions      WorkflowTransition[] @relation("TransitionFromStep")
  toTransitions        WorkflowTransition[] @relation("TransitionToStep")
  currentInInstances   WorkflowInstance[]   @relation("CurrentWorkflowStep")
  instanceSteps        WorkflowInstanceStep[]

  @@unique([workflowDefinitionId, stepKey])
  @@unique([workflowDefinitionId, stepOrder])
  @@index([assignedRoleId])
  @@index([assignedUnitId])
  @@index([assignedUserId])
}

model WorkflowTransition {
  id                   String              @id @default(cuid())
  workflowDefinitionId String
  fromStepId           String
  toStepId             String?
  actionType           WorkflowActionType
  conditionJson        Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workflowDefinition   WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  fromStep             WorkflowStep        @relation("TransitionFromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep               WorkflowStep?       @relation("TransitionToStep", fields: [toStepId], references: [id], onDelete: SetNull)

  @@index([workflowDefinitionId])
  @@index([fromStepId])
  @@index([toStepId])
}

model WorkflowInstance {
  id                   String               @id @default(cuid())
  workflowDefinitionId String
  requestId            String               @unique
  currentStepId        String?
  status               String
  startedAt            DateTime             @default(now())
  endedAt              DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  workflowDefinition   WorkflowDefinition   @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  request              Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  currentStep          WorkflowStep?        @relation("CurrentWorkflowStep", fields: [currentStepId], references: [id], onDelete: SetNull)
  instanceSteps        WorkflowInstanceStep[]

  @@index([workflowDefinitionId])
  @@index([currentStepId])
}

model WorkflowInstanceStep {
  id                   String              @id @default(cuid())
  workflowInstanceId   String
  workflowStepId       String
  assignedToUserId     String?
  startedAt            DateTime?
  completedAt          DateTime?
  status               String
  actionTaken          WorkflowActionType?
  actionByUserId       String?
  actionNote           String?
  dueAt                DateTime?
  isOverdue            Boolean             @default(false)
  metadataJson         Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workflowInstance     WorkflowInstance    @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStep         WorkflowStep        @relation(fields: [workflowStepId], references: [id], onDelete: Restrict)
  assignedTo           User?               @relation("WorkflowInstanceStepAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  actionBy             User?               @relation("WorkflowInstanceStepActionBy", fields: [actionByUserId], references: [id], onDelete: SetNull)
  approvalActions      ApprovalAction[]

  @@index([workflowInstanceId])
  @@index([workflowStepId])
  @@index([assignedToUserId, status])
  @@index([dueAt, isOverdue])
  @@index([actionByUserId])
}

model ApprovalAction {
  id                     String                @id @default(cuid())
  requestId              String
  workflowInstanceStepId String?
  actionType             WorkflowActionType
  actionByUserId         String
  decisionNote           String?
  createdAt              DateTime              @default(now())

  request                Request               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workflowInstanceStep   WorkflowInstanceStep? @relation(fields: [workflowInstanceStepId], references: [id], onDelete: SetNull)
  actionBy               User                  @relation(fields: [actionByUserId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([workflowInstanceStepId])
  @@index([actionByUserId])
}

model InternshipRequest {
  id                  String       @id @default(cuid())
  requestId           String       @unique
  studentUserId       String
  advisorUserId       String?
  companyName         String
  companySector       String?
  companyContactName  String?
  companyContactEmail String?
  internshipType      String
  startDate           DateTime
  endDate             DateTime
  durationDays        Int
  workMode            String
  insuranceRequired   Boolean      @default(false)
  termId              String?
  currentStageNote    String?
  finalDecisionNote   String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  request             Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  student             User         @relation("InternshipStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  advisor             User?        @relation("InternshipAdvisor", fields: [advisorUserId], references: [id], onDelete: SetNull)
  term                AcademicTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([studentUserId])
  @@index([advisorUserId])
  @@index([termId])
}

model EquipmentRequest {
  id                  String      @id @default(cuid())
  requestId           String      @unique
  requesterUserId     String
  labResourceId       String?
  eventPlanId         String?
  equipmentName       String
  equipmentCategory   String
  quantity            Int
  purpose             String
  neededFrom          DateTime?
  neededUntil         DateTime?
  urgencyReason       String?
  stockCheckStatus    String?
  procurementRequired Boolean     @default(false)
  estimatedCost       Decimal?    @db.Decimal(12, 2)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  request             Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requester           User        @relation("EquipmentRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  labResource         Resource?   @relation(fields: [labResourceId], references: [id], onDelete: SetNull)

  @@index([requesterUserId])
