# Runtime
NODE_ENV=development
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusops
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/campusops

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# RabbitMQ
RABBITMQ_URL=amqp://campusops:campusops_mq@localhost:5672
RABBITMQ_MGMT_URL=http://localhost:15672
RABBITMQ_MGMT_PUBLIC=http://localhost:15672
RABBITMQ_MGMT_USER=campusops
RABBITMQ_MGMT_PASS=campusops_mq

# Workers and monitoring
WORKERS_INTERNAL_URL=http://localhost:8001
METRICS_INTERNAL_URL=http://localhost:8000
PROMETHEUS_URL=http://localhost:9090

# Supabase storage
SUPABASE_URL=
SUPABASE_KEY=

# AI service
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://localhost:8010
AI_SERVICE_API_KEY=replace-with-internal-ai-key
AI_SERVICE_TIMEOUT_MS=120000
OLLAMA_URL=http://localhost:11434

# Docker production helper
RUN_MIGRATIONS=false
