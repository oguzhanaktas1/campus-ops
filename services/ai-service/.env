APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010

AI_ENABLED=true
AI_RUNTIME_PROVIDER=ollama

AI_DEFAULT_MODEL=gemma2:2b
OLLAMA_MODEL=gemma2:2b

OLLAMA_BASE_URL=http://host.docker.internal:11434
#OLLAMA_BASE_URL=http://192.168.25.197:11434

AI_REQUEST_TIMEOUT_SECONDS=60
AI_INTERNAL_API_KEY=change-me