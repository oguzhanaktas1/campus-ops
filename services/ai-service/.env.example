# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010
ENABLE_DOCS=true

# AI runtime
AI_ENABLED=true
AI_RUNTIME_PROVIDER=ollama
AI_DEFAULT_MODEL=gemma4:e2b
OLLAMA_MODEL=gemma4:e2b
AI_RUNTIME_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
AI_REQUEST_TIMEOUT_SECONDS=30
AI_FALLBACK_CONFIDENCE=0.25

# Internal service auth
AI_INTERNAL_API_KEY=replace-with-internal-ai-key
