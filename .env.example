# ─────────────────────────────────────────────────────────────────────────────
# CampusOps — Docker Compose environment variables
# Kopyala: cp .env.example .env  →  sonra gerçek değerleri doldur
# Bu dosya repoya commit edilir. .env asla commit edilmez.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=campusops
# openssl rand -hex 32
POSTGRES_PASSWORD=change-me-strong-password

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=campusops
# openssl rand -hex 24
RABBITMQ_PASS=change-me-mq-password
# Bu değer RABBITMQ_USER ve RABBITMQ_PASS ile tutarlı olmalı
RABBITMQ_URL=amqp://campusops:change-me-mq-password@rabbitmq:5672

# ─── JWT ──────────────────────────────────────────────────────────────────────
# openssl rand -hex 64
JWT_SECRET=change-me-use-at-least-64-char-random-string

# ─── AI Service internal API key ─────────────────────────────────────────────
# Backend ile AI service arasındaki iç anahtar — dışarıya açılmaz
# openssl rand -hex 32
AI_SERVICE_API_KEY=change-me-ai-internal-key

# ─── AI Runtime VM (Ollama) ───────────────────────────────────────────────────
# VM'in public IP'si (dışarıdan erişilen)
OLLAMA_BASE_URL=http://YOUR_VM_PUBLIC_IP:11434
# VM'in private/internal IP'si (fallback için)
OLLAMA_FALLBACK_URL=http://YOUR_VM_PRIVATE_IP:11434

# ─── Public URLs ──────────────────────────────────────────────────────────────
# Lokal geliştirme için varsayılan değerler geçerli.
# Production'da kendi domain/IP adreslerinizi yazın.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000
RABBITMQ_MGMT_PUBLIC=http://localhost:15672
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
