# RabbitMQ
RABBITMQ_URL=amqp://campusops:campusops_mq@localhost:5672

# PostgreSQL (Supabase direct connection URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusops

# Redis
REDIS_URL=redis://localhost:6379/0

# SMTP (email gönderimi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@campusflow.com.tr
SMTP_PASSWORD=your-app-password
SMTP_FROM=CampusFlow <noreply@campusflow.com.tr>

# Ortam
ENV=development
LOG_LEVEL=INFO
