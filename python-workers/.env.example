# RabbitMQ
RABBITMQ_URL=amqp://campusops:campusops_mq@localhost:5672

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusops

# Redis
REDIS_URL=redis://localhost:6379/0

# Email
RESEND_API_KEY=
RESEND_FROM=CampusFlow <noreply@campusflow.com.tr>

# Supabase storage
SUPABASE_URL=
SUPABASE_KEY=
STORAGE_BUCKET=campusops-files

# Frontend links used in notifications
FRONTEND_URL=http://localhost:3000

# Runtime
ENV=development
LOG_LEVEL=INFO
